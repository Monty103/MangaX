# Copy to .env.local (gitignored) for local development.
# For Cloudflare Pages, set the same two names as build variables instead.
#
# Both values end up in the client bundle and are safe to publish: access is
# enforced by Postgres row-level security, not by keeping them secret.
# Never put an sb_secret_ key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key
